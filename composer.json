{
    "name": "undabot/json-api-symfony",
    "description": "Allow symfony apps to easy handle JSON API compatible requests and responses",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "beberlei/assert": "^3.3",
        "doctrine/collections": "^2.2",
        "doctrine/orm": "^2.16 || ^3.0",
        "doctrine/persistence": "^3.1 || ^4.0",
        "ramsey/uuid": "^4.7",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/property-access": "^6.4 || ^7.0",
        "symfony/serializer": "^6.4 || ^7.0",
        "symfony/validator": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0",
        "undabot/json-api-core": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-beberlei-assert": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.4",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "Undabot\\SymfonyJsonApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Undabot\\SymfonyJsonApi\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": [
            "php-cs-fixer fix --diff --ansi --dry-run"
        ],
        "phpstan": [
            "php -d memory_limit=-1 vendor/bin/phpstan analyse -n --ansi --no-progress"
        ],
        "test": [
            "php -d memory_limit=-1 vendor/bin/phpunit tests/"
        ],
        "qc": [
            "@lint",
            "@phpstan",
            "@test"
        ]
    }
}
